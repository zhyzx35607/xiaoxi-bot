[Unit]
Description=Clean old NapCat temporary cache files
ConditionPathIsDirectory=/var/lib/napcat/.config/QQ/NapCat/temp

[Service]
Type=oneshot
User=root
Nice=19
ExecStart=/usr/bin/find /var/lib/napcat/.config/QQ/NapCat/temp -type f -mtime +14 -delete
ExecStart=/usr/bin/find /var/lib/napcat/.config/QQ/NapCat/temp -depth -type d -empty -mtime +14 -delete
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/napcat/.config/QQ/NapCat/temp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
