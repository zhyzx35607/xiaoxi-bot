[Unit]
Description=NapCat QQ Client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=napcat
Group=napcat
WorkingDirectory=/var/lib/napcat
Environment=HOME=/var/lib/napcat
Environment=XDG_CONFIG_HOME=/var/lib/napcat/.config
Environment=XDG_CACHE_HOME=/var/lib/napcat/.cache
Environment=XDG_DATA_HOME=/var/lib/napcat/.local/share
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
Environment=NAPCAT_BINARY=/opt/napcat/opt/QQ/qq
EnvironmentFile=-/etc/napcat.env
ExecStart=/usr/bin/python3 /opt/qqbot/deploy/napcat_log_filter.py
Restart=on-failure
RestartSec=15
TimeoutStartSec=120
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
SuccessExitStatus=0 143
UMask=0077
StateDirectory=napcat
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/napcat /opt/napcat
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
Nice=19
MemoryHigh=2G
MemoryMax=3G
CPUQuota=200%
OOMPolicy=stop
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
